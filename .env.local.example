# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-public-key-aqui

# Nunca exponha esta chave no cliente — só é usada em Server Actions/route
# handlers (arquivos que importam "server-only").
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# E-mail transacional (novo caso, nova mensagem, resposta do comitê).
# Em produção (Vercel): defina RESEND_API_KEY e o envio vai pela API do Resend.
# Em desenvolvimento local: deixe RESEND_API_KEY vazio para cair no SMTP do
# Mailpit local (supabase start expõe em 127.0.0.1:55325 neste projeto).
RESEND_API_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=55325
EMAIL_FROM=Voz Segura <onboarding@resend.dev>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
